; G.O.D.O.T — Grand Ol' Dilly-Dallies Of Transportation
; Engine: Godot 4.7.2. Main scene is Gate 3D-0 (the PS2-era 3D build,
; the project's target since the 2026-10-29 pivot). The 2D Gate 0
; systems prototype is still runnable by explicit path:
;   godot --path . res://Main.tscn
; Input is read by physical key/mouse in scripts; a full InputMap
; (touch / keyboard / mouse-only modes, as in the HTML v2) is a
; later gate, noted in README.md.

config_version=5

[application]

config/name="G.O.D.O.T - Grand Ol Dilly-Dallies Of Transportation"
run/main_scene="res://gate3d/Gate3D.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
